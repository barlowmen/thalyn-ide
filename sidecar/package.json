{
	"name": "thalyn-sidecar",
	"private": true,
	"version": "0.0.1",
	"description": "Thalyn agent sidecar process.",
	"type": "commonjs",
	"main": "./out/index.js",
	"scripts": {
		"compile": "tsc -p .",
		"watch": "tsc -w -p .",
		"pretest": "npm run compile && npm run rebuild:node",
		"test": "vitest run",
		"posttest": "npm run rebuild:electron",
		"test:watch": "vitest",
		"rebuild:node": "npm rebuild better-sqlite3",
		"rebuild:electron": "npx --yes @electron/rebuild -v 39.8.8 --only better-sqlite3 -f"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.11",
		"@types/node": "22.x",
		"typescript": "^5.9.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.119",
		"@google/generative-ai": "^0.24.1",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/resources": "^1.30.0",
		"@opentelemetry/sdk-trace-node": "^1.30.0",
		"@opentelemetry/semantic-conventions": "^1.28.0",
		"better-sqlite3": "^12.9.0",
		"keytar": "^7.9.0",
		"ollama": "^0.6.3",
		"openai": "^6.34.0",
		"yaml": "^2.6.1",
		"zod": "^4.3.6"
	}
}
